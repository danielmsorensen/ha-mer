{
  // Two ways to debug the integration in the throwaway dev instance.
  //
  // "Dev Home Assistant (start, open, debug)" is the one-button flow: F5
  // runs the preLaunchTask, which starts the instance and then blocks in a
  // second, foreground task until the debugger port is actually listening;
  // only then does the attach happen, and the UI opens in your browser.
  //
  // Ending it: this is an attach session, so the toolbar shows Disconnect
  // (Shift+F5) rather than Stop. That is fine: the postDebugTask runs on any
  // session end and shuts the instance down. Holding Alt turns Disconnect
  // into Stop (Alt+Shift+F5), which additionally terminates Home Assistant
  // through the debugger before the postDebugTask cleans up.
  //
  // Home Assistant's own file lock and the task's instance limit mean
  // only one copy can run; if one is already running, the launcher reports
  // it and F5 simply attaches to it.
  //
  // "Attach only (dev instance must already be running)" attaches to an
  // instance you started some other way and leaves it running when you
  // disconnect. It has no start task on purpose, so with nothing running it
  // fails at once with "connect ECONNREFUSED 127.0.0.1:5678". If you see
  // that, the Run and Debug dropdown is on this entry; pick the first one.
  //
  // Home Assistant runs inside WSL and reaches this checkout through a
  // symlink in its config directory, so the debugger needs to know how the
  // Windows path of a file maps to the path Python sees. Both spellings are
  // listed; the first is the one Python actually reports. If your WSL user
  // or HA_MER_DEV_CONFIG differ, adjust the first remoteRoot to match.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev Home Assistant (start, open, debug)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "justMyCode": false,
      // Home Assistant spawns pip/uv to install requirements; without this,
      // debugpy attaches to each one as an extra "Subprocess NNNN" session
      // that clutters the debug toolbar and the call stack view.
      "subProcess": false,
      "preLaunchTask": "HA: start dev instance (for debugging)",
      "postDebugTask": "HA: stop dev instance",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/custom_components",
          "remoteRoot": "/home/danielsorensen/ha-mer-dev/custom_components"
        },
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/mnt/d/GitHub/Personal/ha-mer"
        }
      ]
    },
    {
      "name": "Attach only (dev instance must already be running)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "justMyCode": false,
      "subProcess": false,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/custom_components",
          "remoteRoot": "/home/danielsorensen/ha-mer-dev/custom_components"
        },
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/mnt/d/GitHub/Personal/ha-mer"
        }
      ]
    }
  ]
}
