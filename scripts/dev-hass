#!/usr/bin/env bash
# Run, or stop, a throwaway Home Assistant instance in WSL that loads this
# repo's integration directly, for manual testing at http://localhost:8123.
#
# Home Assistant core cannot run on native Windows Python, so like the
# other wrappers this executes inside WSL using the venv that
# scripts/bootstrap-dev created. All the real work happens in
# scripts/dev-hass.wsl, which runs inside the distro; this file only
# translates the repo path and forwards arguments, so nothing here has to
# survive wsl.exe's argument quoting.
#
# The config directory lives in the WSL home (default ~/ha-mer-dev) and is
# safe to delete at any time; it holds only the test instance's own state,
# never anything from your live HA. Its configuration.yaml is copied from
# scripts/dev-configuration.yaml on first run.
#
#   scripts/dev-hass                 start (Ctrl+C to stop)
#   scripts/dev-hass --open          start and open the UI in your browser once it answers
#   scripts/dev-hass --reset         wipe the config dir first, then start
#   scripts/dev-hass --stop          stop the running instance, if any
#
# Starting while an instance is already running is not an error: the launcher
# reports the running instance and exits, so the VS Code "start + debug"
# configuration simply attaches to it.
#
# Environment overrides, matching the other scripts:
#   HA_MER_WSL_DISTRO  WSL distro name        (default: Ubuntu)
#   HA_MER_VENV        venv path inside WSL   (default: ~/.venvs/ha-mer)
#   HA_MER_DEV_CONFIG  config dir inside WSL  (default: ~/ha-mer-dev)
set -euo pipefail

# Prevent Git Bash/MSYS from rewriting POSIX-looking arguments into Windows paths.
export MSYS_NO_PATHCONV=1

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
repo_root_wsl="$(printf '%s' "$repo_root" | sed -E 's#^/([a-zA-Z])/#/mnt/\1/#')"
distro="${HA_MER_WSL_DISTRO:-Ubuntu}"

mode="start"
flags=()
for arg in "$@"; do
  case "$arg" in
    --stop)  mode="stop" ;;
    --reset|--open) flags+=("$arg") ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

# Empty strings tell the WSL side to use its own defaults under $HOME there;
# Windows-side environment variables are not visible inside the distro.
exec wsl.exe -d "$distro" -- bash -l "$repo_root_wsl/scripts/dev-hass.wsl" "$mode" "${flags[@]}" \
  "$repo_root_wsl" "${HA_MER_DEV_CONFIG:-}" "${HA_MER_VENV:-}"
