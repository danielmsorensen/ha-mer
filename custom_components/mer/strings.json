  "exceptions": {
    "command_failed": {
      "message": "Mer rejected the command: {error}"
    },
    "no_active_session": {
      "message": "There is no active charging session to stop"
    },
    "session_not_here": {
      "message": "This charger is not running your charging session"
    }
  }
