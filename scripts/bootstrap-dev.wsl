#!/usr/bin/env bash
# WSL-side helper for scripts/bootstrap-dev, step 4. Builds the assist_pipeline
# requirements that scripts/dev-hass needs, if a C compiler is available.
#
#   bootstrap-dev.wsl VENV_DIR
set -euo pipefail
venv="${1:?venv path required}"

have_headers() {
  "$venv/bin/python" -c 'import sysconfig,os,sys; sys.exit(0 if os.path.exists(os.path.join(sysconfig.get_path("include"), "Python.h")) else 1)'
}
if ! command -v cc >/dev/null 2>&1 || ! have_headers; then
  echo >&2
  echo "bootstrap-dev: WARNING: no C compiler or Python headers in WSL. The tests work without them, but the" >&2
  echo "bootstrap-dev: dev instance's UI cannot load its action list until Home Assistant can build" >&2
  echo "bootstrap-dev: pymicro-vad and pyspeex-noise. Install them once (needs your password):" >&2
  echo "bootstrap-dev:     wsl -d Ubuntu -- sudo apt update" >&2
  echo "bootstrap-dev:     wsl -d Ubuntu -- sudo apt install -y build-essential python3-dev" >&2
  echo "bootstrap-dev: then re-run scripts/bootstrap-dev, or just start the dev instance." >&2
  exit 0
fi

# Take the exact pins from the installed Home Assistant so they track its version.
reqs="$("$venv/bin/python" - <<'PY'
import json, pathlib, homeassistant.components.assist_pipeline as ap
print(*json.load(open(pathlib.Path(ap.__file__).parent / "manifest.json"))["requirements"])
PY
)"
echo "bootstrap-dev: building assist_pipeline requirements: $reqs" >&2
# shellcheck disable=SC2086
"$venv/bin/python" -m pip install --quiet $reqs
