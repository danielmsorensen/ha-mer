{
  "config": {
    "step": {
      "user": {
        "title": "Sign in to Mer",
        "description": "Use the e-mail and password of your Mer Connect / Driver Portal account. Once signed in, add the chargers you want to monitor with the Add charger button on the integration's page.",
        "data": {
          "username": "E-mail",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Mer",
        "description": "The password for {username} no longer works. Enter the new password.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid e-mail or password",
      "cannot_connect": "Could not reach the Mer driver portal",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This Mer account is already configured",
      "reauth_successful": "Re-authentication was successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Poll interval",
        "description": "Chargers are added and removed on the integration's page, not here.",
        "data": {
          "scan_interval": "Seconds between updates"
        }
      }
    }
  },
  "config_subentries": {
    "charger": {
      "entry_type": "Charger",
      "initiate_flow": {
        "user": "Add charger"
      },
      "step": {
        "user": {
          "title": "Find the charging site",
          "description": "Type part of the site name as shown in the Mer app, e.g. NETPark.",
          "data": {
            "search": "Site name"
          }
        },
        "site_select": {
          "title": "Choose the site",
          "description": "Sites matching \"{search}\". Not the right one? Pick \"Search again\" at the bottom.",
          "data": {
            "site_id": "Site"
          }
        },
        "stations": {
          "title": "Choose the chargers to add",
          "description": "Chargers at {site} that you have not added yet. Each one becomes its own device.",
          "data": {
            "station_ids": "Chargers",
            "back": "Not here? Go back and choose a different site"
          }
        }
      },
      "error": {
        "cannot_connect": "Could not reach the Mer driver portal",
        "no_sites": "No site matched that name",
        "no_stations_selected": "Select at least one charger"
      },
      "abort": {
        "already_configured": "That charger is already added",
        "all_stations_configured": "Every charger at that site is already added",
        "invalid_auth": "Stored password no longer works; re-authenticate the integration first",
        "cannot_connect": "Could not reach the Mer driver portal",
        "no_stations": "No chargers were found at that site"
      }
    }
  },
  "entity": {
    "sensor": {
      "station_status": {
        "name": "Status",
        "state": {
          "available": "Available",
          "occupied": "Occupied",
          "charging": "Charging",
          "discharging": "Discharging",
          "paused": "Paused",
          "preparing": "Preparing",
          "finishing": "Finishing",
          "reserved": "Reserved",
          "unavailable": "Unavailable",
          "faulted": "Faulted",
          "unknown": "Unknown"
        }
      },
      "identity_key": { "name": "Identity key" },
      "socket_status": {
        "name": "{socket} status",
        "state": {
          "available": "Available",
          "occupied": "Occupied",
          "charging": "Charging",
          "discharging": "Discharging",
          "paused": "Paused",
          "preparing": "Preparing",
          "finishing": "Finishing",
          "reserved": "Reserved",
          "unavailable": "Unavailable",
          "faulted": "Faulted",
          "unknown": "Unknown"
        }
      },
      "socket_price": { "name": "{socket} price" },
      "socket_max_power": { "name": "{socket} max power" },
      "account_available_sockets": { "name": "Available sockets" },
      "account_sockets_in_use": { "name": "Sockets in use" },
      "active_station": { "name": "Active session charger" },
      "active_started": { "name": "Active session started" },
      "active_energy": { "name": "Active session energy" },
      "active_cost": { "name": "Active session cost" },
      "active_duration": { "name": "Active session duration" },
      "active_socket": { "name": "Active session socket" },
      "last_energy": { "name": "Last session energy" },
      "last_cost": { "name": "Last session cost" },
      "last_started": { "name": "Last session started" },
      "wallet_balance": { "name": "Wallet balance" },
      "station_session_energy": { "name": "Session energy" },
      "station_session_cost": { "name": "Session cost" },
      "station_session_started": { "name": "Session started" },
      "station_session_duration": { "name": "Session duration" }
    },
    "binary_sensor": {
      "socket_available": { "name": "{socket} available" },
      "account_any_available": { "name": "Any socket available" },
      "account_charging": { "name": "Charging" },
      "station_session_here": { "name": "My session here" }
    },
    "button": {
      "socket_start_charge": { "name": "{socket} start charge" },
      "account_stop_charge": { "name": "Stop charge" },
      "station_stop_charge": { "name": "Stop charge" }
    },
    "switch": {
      "notify_available": { "name": "Notify me when available" }
    }
